    "units": {
      "internal_system": "SI",
      "canonical_units": {
        "length": "m",
        "mass": "kg",
        "time": "s",
        "absolute_temperature": "K",
        "temperature_difference": "K",
        "rotation": "rad",
        "stress": "Pa",
        "force": "N",
        "power": "W",
        "energy": "J"
      },
      "conversion_boundary": "仅在输入与输出边界换算；内部运算、比对和保存的规范化记录采用SI。",
      "quantity_fields": ["value", "unit", "temperature_kind", "source_ref"],
      "temperature_kind": ["absolute_temperature", "temperature_difference", "not_temperature"],
      "absolute_temperature_rule": "使用绝对温标换算，必要时含偏移；规范化为K。",
      "temperature_difference_rule": "仅使用温差比例换算，不施加绝对温度偏移；规范化为K并保留温差标签。",
      "conversion_bindings": null,
      "comparison_tolerances": null,
      "unknown_unit_rule": "单位、量纲、温度语义或换算依据不明时阻止写入；不推断当前界面单位。"
    },
    "entity_policy": {
      "primary_key": "stable_id",
      "display_name_is_unique_key": false,
      "resolved_from_required": true,
      "resolver_implementation": null,
      "runtime_ids_are_revision_bound": true,
      "on_geometry_change": "旧ID映射失效，重新解析并核对命名选择与全部载荷作用域。"
    },
    "material_policy": {
      "revision_required": true,
      "on_property_change": "生成同一材料ID的新revision，不覆盖原revision；已引用的旧revision保持不变，直到显式切换。",
      "ansys_native_revision_binding": null,
      "mechanical_assignment": "只切换已有且已确认revision的材料；不得同时创建或修改Engineering Data。"
    },
    "common_gates": ["当前骨架只允许preview_only；所有工具禁止执行。", "后续执行前核对软件版本、项目/模型修订、stable_id映射、作用域、来源与单位。", "有unresolved、null必需值、失效ID或未确认物理条件时阻止写入。"],
    "write_lifecycle": ["准备与读取原值", "写入后以对应层read_property/resolve_entity回读并进行SI比对", "requires_save为true时经Workbench工程保存并回读持久化证据后才可标记persisted"],
    "requires_save_semantics": "会话内写入与回读可先发生；true表示达到持久化完成状态还需要显式工程保存，不表示保存前软件属性完全无效。export_results=false不豁免结果来源与导出文件校验。",
    "invalidates_semantics": "项目要求的下游重新检查/重建清单，不声称ANSYS会自动删除或重建这些对象。先标记stale再逐项处理。",
    "idempotent_semantics": "true仅可在具体前提下证明重试不产生额外修改时使用；null表示未知，禁止自动重试。",
    "failure_policy": {
      "codes": [
        "UNRESOLVED_BINDING",
        "MISSING_REQUIRED_VALUE",
        "STALE_REFERENCE",
        "UNIT_MISMATCH",
        "REVISION_MISMATCH",
        "READBACK_MISMATCH",
        "PARTIAL_WRITE",
        "SAVE_UNCONFIRMED",
        "EXPORT_UNCONFIRMED"
